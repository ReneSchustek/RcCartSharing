parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - vendor
    bootstrapFiles:
        - vendor/autoload.php
    banned_code:
        nodes:
            -
                type: Expr_Eval
                functions: null
            -
                type: Expr_FuncCall
                functions:
                    - unserialize
                    - exec
                    - shell_exec
                    - system
                    - passthru
                    - extract
                    - md5
                    - sha1
                    - rand
                    - mt_rand
                    - var_dump
                    - print_r
                    - dd
                    - dump
                    - error_log
        use_from_tests: false
        non_ignorable: true

includes:
    - vendor/shopwarelabs/phpstan-shopware/rules.neon
    - vendor/ekino/phpstan-banned-code/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
