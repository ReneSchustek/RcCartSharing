{
    "name": "ruhrcoder/rc-cart-sharing",
    "description": "Shopware 6 Plugin — Warenkorb speichern und über einen Verweis teilen, ohne die Angaben der Positionen zu verlieren.",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "version": "0.2.0",
    "authors": [
        {"name": "René Schustek", "email": "rene@ruhrcoder.de", "homepage": "https://ruhrcoder.de", "role": "Developer"}
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2",
        "ekino/phpstan-banned-code": "^3.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcCartSharing\\RcCartSharing",
        "label": {
            "de-DE": "Warenkorb speichern und teilen",
            "en-GB": "Save and share cart"
        },
        "description": {
            "de-DE": "Der Kunde speichert seinen Warenkorb und teilt ihn über einen Verweis. Meterlängen, Farben und Kundeneingaben bleiben dabei erhalten.",
            "en-GB": "Customers save their cart and share it via a link. Cut lengths, colours and customer inputs are preserved."
        },
        "manufacturerLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        },
        "supportLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcCartSharing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcCartSharing\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": ["@cs-check", "@phpstan", "@test"]
    }
}
