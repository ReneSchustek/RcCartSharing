{
    "name": "ruhrcoder/rc-cart-sharing",
    "description": "Shopware 6 Plugin — Warenkorb speichern und über einen Verweis teilen, ohne die Angaben der Positionen zu verlieren.",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "0.2.1",
    "authors": [
        {
            "name": "René Schustek",
            "email": "info@ruhrcoder.de",
            "homepage": "https://ruhrcoder.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2",
        "ekino/phpstan-banned-code": "^3.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "shopwarelabs/phpstan-shopware": "^0.2"
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcCartSharing\\RcCartSharing",
        "label": {
            "de-DE": "Warenkorb speichern und teilen",
            "en-GB": "Save and share cart"
        },
        "description": {
            "de-DE": "Der Kunde speichert seinen Warenkorb und teilt ihn über einen Verweis. Meterlängen, Farben und Kundeneingaben bleiben dabei erhalten.",
            "en-GB": "Customers save their cart and share it via a link. Cut lengths, colours and customer inputs are preserved."
        },
        "manufacturerLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        },
        "supportLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcCartSharing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcCartSharing\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        },
        "audit": {
            "ignore": {
                "PKSA-s52d-n7sx-trsg": "Betroffen ist allein die OAuth-Zwischenschicht von mcp/sdk 0.8 (GHSA-f4rf-6ghj-mhr6): Ihre Endpunkte lesen Anfragen ohne Größengrenze. Shopware 6.7.15 nutzt nur StreamableHttpTransport mit eigener Anmeldung (McpAuthenticationListener), nicht diese Zwischenschicht. Die behobene Fassung 0.9.0 lässt der Kern noch nicht zu. Freigegeben von Rene am 10.11.2026, Wiedervorlage 01.02.2027 oder sobald Shopware mcp/sdk 0.9 erlaubt."
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    }
}
